{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Name"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "category_id": {
      "type": "string",
      "title": "Category ID"
    },
    "category_name": {
      "type": "string",
      "title": "Category Name"
    },
    "price": {
      "type": "number",
      "title": "Price (KES)"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Images"
    },
    "sizes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Available Sizes"
    },
    "stock": {
      "type": "number",
      "title": "Stock Quantity",
      "default": 0
    },
    "featured": {
      "type": "boolean",
      "title": "Featured",
      "default": false
    },
    "best_seller": {
      "type": "boolean",
      "title": "Best Seller",
      "default": false
    }
  },
  "required": [
    "name",
    "slug",
    "category_id",
    "price"
  ]
}